{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "Node10",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "noEmit": false,
        "declaration": true,
        "declarationDir": "./build/types",
        "emitDeclarationOnly": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*",
        "vite.config.ts",
        "scripts/**/*",
        "docs/**/*"
    ],
    "exclude": [
        "node_modules",
        "build"
    ]
}
