{
    "compilerOptions": {
        "target": "esnext",
        "module": "node16",
        "moduleResolution": "node16",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "noEmit": false,
        "declaration": true,
        "declarationDir": "./build/types",
        "emitDeclarationOnly": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["vitest/globals"],
        "baseUrl": ".",
        "paths": {
            "@shopware-ag/dive": ["./src/index.ts"],
            "@shopware-ag/dive/animation": [
                "./src/modules/animation/index.ts"
            ],
            "@shopware-ag/dive/ar": [
                "./src/modules/ar/index.ts"
            ],
            "@shopware-ag/dive/assetconverter": [
                "./src/modules/assetconverter/index.ts"
            ],
            "@shopware-ag/dive/assetexporter": [
                "./src/modules/assetexporter/index.ts"
            ],
            "@shopware-ag/dive/assetloader": [
                "./src/modules/assetloader/index.ts"
            ],
            "@shopware-ag/dive/axiscamera": [
                "./src/modules/axiscamera/index.ts"
            ],
            "@shopware-ag/dive/mediacreator": [
                "./src/modules/mediacreator/index.ts"
            ],
            "@shopware-ag/dive/orbitcontroller": [
                "./src/modules/orbitcontroller/index.ts"
            ],
            "@shopware-ag/dive/state": [
                "./src/modules/state/index.ts"
            ],
            "@shopware-ag/dive/systeminfo": [
                "./src/modules/systeminfo/index.ts"
            ],
            "@shopware-ag/dive/toolbox": [
                "./src/modules/toolbox/index.ts"
            ]
        }
    },
    "include": [
        "src/**/*",
        "docs/**/*",
        "scripts/**/*.ts",
        "vite.shared.ts"
    ],
    "exclude": [
        "node_modules",
        "build"
    ]
}
